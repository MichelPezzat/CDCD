from torch.utils.data import Dataset
import numpy as np
import io
import pandas as pd
from PIL import Image
import os
import json
import random
from synthesis.utils.misc import instantiate_from_config
from tqdm import tqdm
import pickle

def load_img(filepath):
    img = Image.open(filepath).convert('RGB')
    return img

def split_text(path):
    
   with open(path, 'r') as input_txt:
        text = input_txt.read()
        if  'IMPRESSION' in text:
            text = text.split("IMPRESSION")[1]
        elif 'FINDINGS' in text:
            text= text.split("FINDINGS")[1]
        text = text.split('.')[:-1]
   return text 


class MIMIC_CXRDataset(Dataset):
    def __init__(self, data_root, negative_sample_path, phase = 'train', im_preprocessor_config=None):
        self.transform = instantiate_from_config(im_preprocessor_config)
        
        self.image_folder = os.path.join(data_root, 'mimic-cxr-jpg/2.1.0')

        image_id = pd.read_csv(os.path.join(self.image_folder,'mimic-cxr-2.0.0-split.csv.gz'))
        image_record = pd.read_csv(os.path.join(data_root,'mimic-cxr/2.1.0/cxr-record-list.csv.gz'))
        image_meta = pd.read_csv(os.path.join(self.image_folder,'mimic-cxr-2.0.0-metadata.csv.gz'))
        image_meta = image_meta['ViewCodeSequence_CodeMeaning'].str.contains('poster')

        self.image_record = image_record[image_id['split'].str.contains(phase)]
        self.image_files = [x.replace('dcm','jpg') for i,x in enumerate(image_record['path']) if image_meta[i]]
   
        self.image_study = pd.read_csv(os.path.join(data_root,'mimic-cxr/2.1.0/cxr-study-list.csv.gz'))


        self.num = len(self.image_files)
        self.phase = phase

        self.caption_dict = {}

        for i,index in enumerate(self.image_record.index):
            

            image_id = self.image_record['study_id'][index]

            caption_path = self.image_study[self.image_study['path'].str.contains(str(image_id))]['path'].to_string(index=False)
            caption_path = os.path.join(data_root, os.path.join('mimic-cxr/2.1.0',caption_path))

            # print("check name and text path:", index, name, this_text_path)
            caption = split_text(caption_path)
            self.caption_dict[image_id] = caption


        if self.phase == 'train' and self.negative_sample_path != None:
            # print("negative_sample_path:", negative_sample_path)
            with open(negative_sample_path, 'r') as f:
                self.extra_img = json.load(f)
            # self.extra_img = os.path.join()
            print("negative_sample_path:", negative_sample_path, len(self.extra_img))
            print("check path:", self.extra_img[0])
        else:
            self.extra_img = None


        print("load caption file done")


    def __len__(self):
        return len(self)
 
    def __getitem__(self, index):
        
        image_name = self.image_files[index]
        image_path = os.path.join( self.folder_path, image_name)
        image = load_img(image_path)
        #print(image_path)
        
        
        image = np.array(image).astype(np.uint8)
        image = self.transform(image = image)['image']
        image_id = self.image_record['study_id'][index]
        
        caption_list = self.caption_dict[image_id]
        caption = random.choice(caption_list).replace('\n', '').lower()
        #print(caption)
        # else:
        if self.phase == 'train' and self.extra_img != None:

            for i in range(10):
                idx = random.randint(0, self.__len__()-1)
                #neg_img_path = self.A_paths[idx % self.A_size]
                neg_img_path = self.image_files[indx % self.__len__()]
                img = load_img(neg_img_path)
                image = np.array(image).astype(np.uint8)                
                img = self.transform(image = img)['image']
                if i == 0:
                    neg_img = np.expand_dims(img, axis=0)
                else:
                    img = np.expand_dims(img, axis=0)
